---
// The form header, filled in. Shared by every page so the nav and the version
// line cannot drift apart; `current` is the only thing that differs.
import { siGithub } from 'simple-icons';
import repo from '../data/repo.json';

const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const nav = [
  { href: `${base}/`, label: 'Overview', key: 'index' },
  { href: `${base}/docs/`, label: 'Documentation', key: 'docs' },
  { href: `${base}/bench/`, label: 'Benchmarks', key: 'bench' },
];

// A count is read at build time and baked in, so it is a snapshot rather than
// a live number. Below ten it says nothing rather than something small: an
// absent number is honest, a rendered zero is just sad.
const stars = repo.stars >= 10 ? repo.stars.toLocaleString('en-US') : '';
---
<header class="mast">
  <div class="wrap">
    <a class="brand" href={`${base}/`} aria-label="recall, home">
      <!-- The Excluded Register: a ruled ledger cell, sprocket holes down the
           left rail, three rows found and one row broken. The break is geometry,
           not a hue, so it survives one ink and 16px. -->
      <svg viewBox="0 0 40 40" role="img" aria-label="recall" shape-rendering="crispEdges">
        <rect x=".75" y=".75" width="38.5" height="38.5" fill="none" stroke="var(--rule)" stroke-width="1.5"/>
        <line x1="9" y1="0" x2="9" y2="40" stroke="var(--rule)" stroke-width="1"/>
        <circle cx="4.5" cy="6" r="2" fill="var(--hole)"/>
        <circle cx="4.5" cy="20" r="2" fill="var(--hole)"/>
        <circle cx="4.5" cy="34" r="2" fill="var(--hole)"/>
        <rect x="13" y="5" width="22" height="5" fill="var(--ledger)"/>
        <rect x="13" y="14" width="22" height="5" fill="var(--ledger)"/>
        <rect x="13" y="23" width="8.4" height="5" fill="var(--carbon)"/>
        <rect x="26.6" y="23" width="8.4" height="5" fill="var(--carbon)"/>
        <rect x="13" y="31" width="22" height="5" fill="var(--ledger)"/>
      </svg>
      <b>recall</b>
    </a>
    <div class="mastEnd">
      <nav class="nav" aria-label="Primary">
        {nav.map(n => (
          <a href={n.href} aria-current={n.key === current ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
      <a class="star" href="https://github.com/mayberuk/recall"
         rel="noopener" aria-label="Star recall on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={siGithub.path} /></svg>
        <b>Star</b>
        {stars && <span class="starN">{stars}</span>}
      </a>
      <p class="formno">v1.1.0 · MIT</p>
    </div>
  </div>
</header>
