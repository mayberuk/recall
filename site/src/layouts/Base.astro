---
import '../styles/global.css';
const { title, description, markdown, schema } = Astro.props;

// Unfurlers fetch these from a crawler with no page context, so every URL has
// to be absolute. Astro.site carries the origin; Astro.url the path.
const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = new URL(`${import.meta.env.BASE_URL}/social-preview.png`.replace(/\/{2,}/g, '/'), Astro.site);

// Structured data is the one thing a retrieval layer reads the same way a
// search engine does: it answers "what is this, who made it, what does it
// cost" without having to infer any of it from prose. Every page carries the
// project identity; a page adds its own on top.
const identity = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'recall',
  alternateName: 'recall CLI',
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Command Line Utility',
  operatingSystem: 'macOS, Linux, Windows',
  softwareVersion: '1.1.0',
  url: 'https://recall.mayberuk.com',
  downloadUrl: 'https://github.com/mayberuk/recall/releases',
  codeRepository: 'https://github.com/mayberuk/recall',
  programmingLanguage: 'Go',
  license: 'https://opensource.org/licenses/MIT',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'mayberuk', url: 'https://github.com/mayberuk' },
  description:
    'recall searches every past coding-agent session transcript stored on a machine, from Claude Code and Codex CLI, from any checkout of a repository, in about 30 milliseconds and with no index. It also serves the same questions to an agent over the Model Context Protocol. Every answer states what it did not search.',
  // The words people actually type when they have this problem and do not yet
  // know this tool exists. Every one of them is answered somewhere on the site
  // in prose a reader can check; none of them is here alone.
  keywords: [
    'search Claude Code history', 'Claude Code session history', 'Claude Code transcripts',
    'search Codex CLI sessions', 'Codex CLI history', 'coding agent conversation search',
    'AI chat history search CLI', 'grep Claude Code logs', 'find past AI coding conversation',
    'recover deleted Claude Code session', 'where does Claude Code store sessions',
    'MCP server for session history', 'Model Context Protocol memory server',
    'agent memory search tool', 'local first developer search', 'no index full text search Go',
    'Cursor MCP server', 'Windsurf MCP server', 'Gemini CLI MCP server',
  ],
  alternateName: ['recall CLI', 'recall MCP server', 'mayberuk/recall'],
  featureList: [
    'Fuzzy prefix search across every past coding-agent conversation',
    'Resolves a repository by its git remote, so every clone and worktree is one history',
    'No index to build or keep current; the whole store is read on every query',
    'Model Context Protocol server with five read-only tools',
    'Every answer prints its own coverage: what was searched, what was not, and the token cost',
    'Runs entirely on the local machine with no account, no upload and no background process',
  ],
};
const graph = [identity, ...(schema || [])];
const schemaKeywords = identity.keywords;
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={(schemaKeywords || []).join(', ')} />
<meta name="color-scheme" content="light dark" />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="author" content="mayberuk" />
<link rel="canonical" href={canonical} />
{markdown && <link rel="alternate" type="text/markdown" href={markdown} title="This page as plain markdown" />}
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

<!-- The card a link to this page unfurls into. A raster, not the SVG beside it:
     Slack, iMessage and Twitter will not render SVG in a preview. -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={preview} />
<meta property="og:image:width" content="2560" />
<meta property="og:image:height" content="1280" />
<meta property="og:image:alt" content="recall, a line-printer ledger sheet stating what the tool searched and what it did not." />
<meta property="og:site_name" content="recall" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={preview} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preload" as="font" type="font/woff2" href="/fonts/bigshoulders.woff2" crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/fonts/archivo.woff2" crossorigin />
<script type="application/ld+json" set:html={JSON.stringify(graph)}></script>
<script is:inline>
  /* Before the first paint, so a reader who chose a theme never watches the
     other one appear first. No stored choice leaves the attribute off, which
     is what hands the decision back to prefers-color-scheme. */
  try {
    var t = localStorage.getItem('recall-theme');
    if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
  } catch (e) {}
</script>
</head>
<body>
<!--
THESIS: recall is the only search tool that records what it did NOT find; this page is a
deck-log sheet and refuses the category's near-black hero with a faked terminal window.
OWN-WORLD: grey-green ledger stock, printed blue rules, iron-gall ink, one rose stamp;
Big Shoulders masthead, Archivo form furniture, JetBrains Mono for every datum; ruled
columns throughout, no cards, no gradients.
STORY: a developer who lost an answer reads real output, learns the footer states what
was not searched, and copies the install line.
FIRST VIEWPORT: masthead rule; headline as three stamped declaratives; facts set small in
a ruled register at right; install entry beneath, and a query line that types itself.
FORM: Deck Log, candidate 7 of my grounded list, seed f80dcd8b.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->
<a class="skip" href="#main">Skip to content</a>
<slot />
<script is:inline>
  /* The theme control. Three states, and `auto` is a real one: it removes the
     attribute rather than writing today's system value, so a reader who
     switches their machine to night later gets night here too. */
  (function () {
    var box = document.querySelector('.theme');
    if (!box) return;
    var read = function () {
      try { return localStorage.getItem('recall-theme') || 'auto'; } catch (e) { return 'auto'; }
    };
    var paint = function (v) {
      box.querySelectorAll('button').forEach(function (b) {
        b.setAttribute('aria-pressed', b.dataset.theme === v ? 'true' : 'false');
      });
    };
    box.addEventListener('click', function (e) {
      var b = e.target.closest('button');
      if (!b) return;
      var v = b.dataset.theme;
      if (v === 'auto') delete document.documentElement.dataset.theme;
      else document.documentElement.dataset.theme = v;
      try { v === 'auto' ? localStorage.removeItem('recall-theme') : localStorage.setItem('recall-theme', v); } catch (err) {}
      paint(v);
    });
    paint(read());
    box.hidden = false;
  })();

  /* One delegated handler for every copyable code block on every page. The
     text copied is the source the block was built from, not the rendered
     spans, because what lands on a clipboard has to be what a shell accepts. */
  document.addEventListener('click', function (e) {
    var b = e.target.closest && e.target.closest('[data-code]');
    if (!b) return;
    // A button that is only a label swaps its own text; one that is a whole
    // tile swaps the child it marked, so the rest of the tile survives.
    var slot = b.querySelector('[data-label]') || b;
    var was = slot.textContent;
    navigator.clipboard.writeText(b.getAttribute('data-code')).then(function () {
      b.classList.add('ok');
      slot.textContent = 'copied to your clipboard';
      clearTimeout(b._t);
      b._t = setTimeout(function () { b.classList.remove('ok'); slot.textContent = was; }, 2200);
    });
  });
</script>
</body>
</html>
