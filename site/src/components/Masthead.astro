---
// The form header, filled in. Shared by every page so the nav and the version
// line cannot drift apart; `current` is the only thing that differs.
import { siGithub } from 'simple-icons';
import repo from '../data/repo.json';

const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
/* Drawn here rather than pulled from an icon set, because every set draws
   rounded strokes on a 24-unit grid and this masthead is built out of the
   same crisp-edged rectangles the brand mark is: a printed sheet with one
   row marked, a bound manual, and bars on a baseline. They inherit
   currentColor, so the nav's hover and current-page states carry them. */
const nav = [
  {
    href: `${base}/`, label: 'Overview', key: 'index',
    // the printout, with the marked row running edge to edge, which is
    // exactly what the sheet on that page does to the row it found
    art: [
      { x: 3.5, y: 3.5, w: 17, h: 17, o: 1 },
      { x: 7, y: 7.2, w: 6.4, h: 1.5 },
      { x: 3.5, y: 10.8, w: 17, h: 3.4 },
      { x: 7, y: 16.4, w: 6.4, h: 1.5 },
    ],
  },
  {
    href: `${base}/docs/`, label: 'Documentation', key: 'docs',
    // a bound manual: a solid spine standing beside the page, so the
    // silhouette differs from the sheet above rather than only the inside
    art: [
      { x: 3.6, y: 3.5, w: 3.4, h: 17 },
      { x: 8.7, y: 3.5, w: 11.8, h: 17, o: 1 },
      { x: 11.4, y: 7.4, w: 6.4, h: 1.5 },
      { x: 11.4, y: 11.2, w: 6.4, h: 1.5 },
      { x: 11.4, y: 15, w: 4, h: 1.5 },
    ],
  },
  {
    href: `${base}/bench/`, label: 'Benchmarks', key: 'bench',
    // bars against a baseline, the same figure the page itself draws
    art: [
      { x: 3.6, y: 18.6, w: 16.8, h: 1.8 },
      { x: 5.2, y: 13, w: 3.6, h: 5.1 },
      { x: 10.2, y: 9, w: 3.6, h: 9.1 },
      { x: 15.2, y: 5, w: 3.6, h: 13.1 },
    ],
  },
];

// A count is read at build time and baked in, so it is a snapshot rather than
// a live number. Below ten it says nothing rather than something small: an
// absent number is honest, a rendered zero is just sad.
const stars = repo.stars >= 10 ? repo.stars.toLocaleString('en-US') : '';
---
<header class="mast">
  <div class="wrap">
    <a class="brand" href={`${base}/`} aria-label="recall, home">
      <!-- The Excluded Register: a ruled ledger cell, sprocket holes down the
           left rail, three rows found and one row broken. The break is geometry,
           not a hue, so it survives one ink and 16px. -->
      <svg viewBox="0 0 40 40" role="img" aria-label="recall" shape-rendering="crispEdges">
        <rect x=".75" y=".75" width="38.5" height="38.5" fill="none" stroke="var(--rule)" stroke-width="1.5"/>
        <line x1="9" y1="0" x2="9" y2="40" stroke="var(--rule)" stroke-width="1"/>
        <circle cx="4.5" cy="6" r="2" fill="var(--hole)"/>
        <circle cx="4.5" cy="20" r="2" fill="var(--hole)"/>
        <circle cx="4.5" cy="34" r="2" fill="var(--hole)"/>
        <rect x="13" y="5" width="22" height="5" fill="var(--ledger)"/>
        <rect x="13" y="14" width="22" height="5" fill="var(--ledger)"/>
        <rect x="13" y="23" width="8.4" height="5" fill="var(--carbon)"/>
        <rect x="26.6" y="23" width="8.4" height="5" fill="var(--carbon)"/>
        <rect x="13" y="31" width="22" height="5" fill="var(--ledger)"/>
      </svg>
      <b>recall</b>
    </a>
    <div class="mastEnd">
      <nav class="nav" aria-label="Primary">
        {nav.map(n => (
          <a href={n.href} aria-current={n.key === current ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" shape-rendering="crispEdges">
              {n.art.map(r => (
                <rect x={r.x} y={r.y} width={r.w} height={r.h}
                      fill={r.o ? 'none' : 'currentColor'}
                      stroke={r.o ? 'currentColor' : undefined}
                      stroke-width={r.o ? 1.6 : undefined} />
              ))}
            </svg>
            <span>{n.label}</span>
          </a>
        ))}
      </nav>
      <!-- Hidden until its script runs: a control that cannot change anything
           is worse than one that is not offered. -->
      <div class="theme" role="group" aria-label="Colour theme" hidden>
        {[['auto', 'Auto'], ['light', 'Light'], ['dark', 'Dark']].map(([v, label]) => (
          <button type="button" data-theme={v} aria-pressed="false">{label}</button>
        ))}
      </div>
      <a class="star" href="https://github.com/mayberuk/recall"
         rel="noopener" aria-label="Star recall on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={siGithub.path} /></svg>
        <b>Star</b>
        {stars && <span class="starN">{stars}</span>}
      </a>
      <p class="formno">v1.1.0 · MIT</p>
    </div>
  </div>
</header>
